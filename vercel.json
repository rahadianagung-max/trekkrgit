{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/sheet"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "venue.trekkr.online" }],
      "destination": "/venue/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.trekkr.online" }],
      "destination": "/admin/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "superadmin.trekkr.online" }],
      "destination": "/superadmin/$1"
    },
    { "source": "/player/(.*)", "destination": "/player/index.html" },
    { "source": "/venue/(.*)", "destination": "/venue/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/superadmin/(.*)", "destination": "/superadmin/index.html" }
  ]
}