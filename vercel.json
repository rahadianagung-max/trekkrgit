{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/sheet"
    },
    {
      "source": "/player/:match*",
      "destination": "/player/index.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },

    { "source": "/season", "destination": "/season.html" },
    { "source": "/sessions", "destination": "/sessions.html" },
    { "source": "/sessions/:id", "destination": "/session.html" },
    { "source": "/claim", "destination": "/claim.html" },
    { "source": "/passport", "destination": "/passport.html" },
    { "source": "/ranking", "destination": "/ranking.html" },
    { "source": "/series", "destination": "/series.html" }
  ]
}
