{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/sheet"
    },
    {
      "source": "/:match*",
      "has": [{ "type": "host", "value": "venue.trekkr.online" }],
      "destination": "/venue/:match*"
    },
    {
      "source": "/:match*",
      "has": [{ "type": "host", "value": "admin.trekkr.online" }],
      "destination": "/admin/:match*"
    },
    {
      "source": "/:match*",
      "has": [{ "type": "host", "value": "superadmin.trekkr.online" }],
      "destination": "/superadmin/:match*"
    },
    { 
      "source": "/player/:match*", 
      "destination": "/player/index.html" 
    },
    { 
      "source": "/venue/:match*", 
      "destination": "/venue/index.html" 
    },
    { 
      "source": "/admin/:match*", 
      "destination": "/admin/index.html" 
    },
    { 
      "source": "/superadmin/:match*", 
      "destination": "/superadmin/index.html" 
    }
  ]
}